+    /// Perigee measurement hook (engine/tools/desktop), called for every justified line before its
+    /// extra width is spread over its gaps (or, when negative, taken out of them). With
+    /// PERIGEE_GAPS_CSV it writes one row per line. With PERIGEE_GAPS_CAP_EM it returns true for a
+    /// line of two gaps or more whose gap, the space plus its share of the extra width, would be wider
+    /// than the ceiling: the caller then aligns it left. Both unset, it returns false at once.
+    bool perigeeGaps( formatted_line_t * frmline, int usable_width, int extra_width ) {
+        FILE * out = perigeeGapsCsv();
+        double cap_em = perigeeGapsCapEm();
+        if ( (!out && cap_em <= 0) || frmline->word_count == 0 )
+            return false;
+        LVFont * font = NULL;
+        ldomNode * node = NULL;
+        for ( int i=0; i<(int)frmline->word_count && !font; i++ ) {
+            src_text_fragment_t * src = &m_pbuffer->srctext[frmline->words[i].src_text_index];
+            if ( !(src->flags & LTEXT_SRC_IS_OBJECT) ) {
+                font = (LVFont *) src->t.font;
+                node = (ldomNode *) src->object;
+            }
+        }
+        if ( !font )
+            return false;
+        int gaps = 0;
+        int chars = 0;
+        for ( int i=0; i<(int)frmline->word_count; i++ ) {
+            if ( i < (int)frmline->word_count-1 && frmline->words[i].flags & LTEXT_WORD_CAN_ADD_SPACE_AFTER )
+                gaps++;
+            if ( !(m_pbuffer->srctext[frmline->words[i].src_text_index].flags & LTEXT_SRC_IS_OBJECT) )
+                chars += frmline->words[i].t.len;
+        }
+        int space = font->getCharWidth(' ');
+        bool capped = cap_em > 0 && gaps >= 2 && extra_width > 0
+                && space + (double)extra_width / gaps > cap_em * font->getSize();
+        if ( out ) {
+            bool hyphen = frmline->words[frmline->word_count-1].flags & LTEXT_WORD_CAN_HYPH_BREAK_LINE_AFTER;
+            fprintf(out, "%s,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d\n", font->getTypeFace().c_str(), font->getSize(),
+                    space, usable_width, (int)frmline->width, extra_width, gaps, (int)frmline->word_count, chars,
+                    hyphen ? 1 : 0, node ? (int)node->getDataIndex() : -1, m_y, capped ? 1 : 0);
+        }
+        return capped;
+    }
