+/// Perigee measurement hook (engine/tools/desktop): the stream named by PERIGEE_GAPS_CSV, opened
+/// for appending on the first call, with the header written to an empty file; NULL when the variable
+/// is unset. Not static: the gaps CLI declares it and writes its page markers through the same stream,
+/// so they stay in order with the rows.
+FILE * perigeeGapsCsv() {
+    static FILE * out = NULL;
+    static bool checked = false;
+    if ( !checked ) {
+        checked = true;
+        const char * path = getenv("PERIGEE_GAPS_CSV");
+        if ( path && *path && (out = fopen(path, "a")) != NULL && ftell(out) == 0 )
+            fprintf(out, "face,size_px,space_px,usable_px,natural_px,extra_px,gaps,words,chars,hyphen,node,y,capped\n");
+    }
+    return out;
+}
+
+/// PERIGEE_GAPS_CAP_EM: the widest gap of a justified line, in ems of the line's font; a line that
+/// would get a wider one is left ragged. Read once; 0 (no ceiling) when unset or not a positive number.
+static double perigeeGapsCapEm() {
+    static double cap = 0;
+    static bool checked = false;
+    if ( !checked ) {
+        checked = true;
+        const char * value = getenv("PERIGEE_GAPS_CAP_EM");
+        if ( value && *value && (cap = atof(value)) < 0 )
+            cap = 0;
+    }
+    return cap;
+}
