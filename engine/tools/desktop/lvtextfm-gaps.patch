+    /// Perigee lookahead: the gap, in px, of a justified line from start to the wrap at end: the width
+    /// its letters leave, shared by its gaps (a space at the wrap is not laid out). 0 without a gap.
+    double perigeeLineGap( int start, int end, int x, int maxWidth, bool hyphen, int & gaps ) {
+        int last = end;
+        while ( last > start && (m_flags[last] & LCHAR_IS_SPACE) )
+            last--;
