+    /// Perigee measurement hook (engine/tools/desktop): with PERIGEE_GAPS_CSV naming a file,
+    /// one row per justified line, taken before the line's extra width is spread over its gaps
+    /// (or, when negative, taken out of them). The variable is read once; unset, nothing is done.
+    void perigeeLogGaps( formatted_line_t * frmline, int usable_width, int extra_width ) {
+        static FILE * out = NULL;
+        static bool checked = false;
+        if ( !checked ) {
+            checked = true;
+            const char * path = getenv("PERIGEE_GAPS_CSV");
+            if ( path && *path && (out = fopen(path, "a")) != NULL && ftell(out) == 0 )
+                fprintf(out, "face,size_px,space_px,usable_px,natural_px,extra_px,gaps,words,chars,hyphen,node,y\n");
+        }
+        if ( !out || frmline->word_count == 0 )
+            return;
+        LVFont * font = NULL;
+        ldomNode * node = NULL;
+        for ( int i=0; i<(int)frmline->word_count && !font; i++ ) {
+            src_text_fragment_t * src = &m_pbuffer->srctext[frmline->words[i].src_text_index];
+            if ( !(src->flags & LTEXT_SRC_IS_OBJECT) ) {
+                font = (LVFont *) src->t.font;
+                node = (ldomNode *) src->object;
+            }
+        }
+        if ( !font )
+            return;
+        int gaps = 0;
+        int chars = 0;
+        for ( int i=0; i<(int)frmline->word_count; i++ ) {
+            if ( i < (int)frmline->word_count-1 && frmline->words[i].flags & LTEXT_WORD_CAN_ADD_SPACE_AFTER )
+                gaps++;
+            if ( !(m_pbuffer->srctext[frmline->words[i].src_text_index].flags & LTEXT_SRC_IS_OBJECT) )
+                chars += frmline->words[i].t.len;
+        }
+        bool hyphen = frmline->words[frmline->word_count-1].flags & LTEXT_WORD_CAN_HYPH_BREAK_LINE_AFTER;
+        fprintf(out, "%s,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d\n", font->getTypeFace().c_str(), font->getSize(),
+                font->getCharWidth(' '), usable_width, (int)frmline->width, extra_width, gaps,
+                (int)frmline->word_count, chars, hyphen ? 1 : 0, node ? (int)node->getDataIndex() : -1, m_y);
+    }
