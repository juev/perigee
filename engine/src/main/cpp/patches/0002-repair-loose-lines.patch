+    /// Perigee repair: puts the planned break of the line that starts at pos into wrapPos, in
+    /// place of the greedy one, and sets the hyphenation flag where the plan hyphenates and the greedy
+    /// loop did not (and clears it where the greedy loop did and the plan does not). lastFit is the
+    /// furthest wrap the greedy loop found to fit. A plan that disagrees with the loop (no break left, a
+    /// break before pos or past lastFit) is dropped and the rest of the paragraph stays greedy.
+    void perigeeTakePlannedBreak( int pos, int lastFit, int lastHyphWrap, int & wrapPos ) {
+        int b = m_perigee_line < m_perigee_breaks.length() ? m_perigee_breaks[m_perigee_line] : -1;
+        if ( b < pos || b > lastFit ) {
+            m_perigee_para = false;
+            return;
+        }
+        if ( lastHyphWrap >= 0 && lastHyphWrap != b )
+            m_flags[lastHyphWrap] &= ~LCHAR_ALLOW_HYPH_WRAP_AFTER;
+        if ( m_perigee_hyphens[m_perigee_line] )
+            m_flags[b] |= LCHAR_ALLOW_HYPH_WRAP_AFTER;
+        wrapPos = b;
+        m_perigee_line++;
+    }
