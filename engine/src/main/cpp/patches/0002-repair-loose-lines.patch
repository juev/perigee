+    /// Perigee repair: a paragraph breaker applied only where a line is loose.
+    /// The greedy lines of the paragraph are worked out first (perigeeGreedyLine). A paragraph with no
+    /// gap wider than PERIGEE_LOOSE_EM gets no plan, and the line loop runs as it always does. Otherwise
+    /// every loose line opens a window, PERIGEE_WINDOW_BACK lines before it and PERIGEE_WINDOW_FORWARD after;
+    /// only there are other breaks offered and words hyphenated. Outside the windows the greedy breaks are
+    /// the only nodes, so those lines stay as they are. A line costs nothing up to PERIGEE_FREE_EM, past
+    /// that 100 ((gap - free) / 0.25 em)^3; the other costs are the PERIGEE_COST_ constants, measured in
+    /// docs/spikes/word-gaps-preview.md. The chosen breaks go through the unchanged line loop.
+    bool perigeeRepairParagraph( src_text_fragment_t * para ) {
+        m_perigee_breaks.clear();
+        m_perigee_hyphens.clear();
+        m_perigee_line = 0;
+        if ( !perigeeBreakerInScope( para ) )
+            return false;
+        int maxWidth = getCurrentLineWidth();
+        int firstX = m_indent_current;
+        int nextX = m_indent_first_line_done ? m_indent_current : m_indent_after_first_line;
+
+        // The greedy lines: each one's last position and whether it ends in a hyphen.
+        LVArray<int> greedyEnd;
+        LVArray<int> greedyHyphen;
+        LVArray<int> looseLine;
+        for ( int pos=0; pos<m_length; ) {
+            int x = pos == 0 ? firstX : nextX;
+            int end, gaps;
+            bool hyphen;
+            if ( !perigeeGreedyLine( pos, x, maxWidth, end, hyphen ) ) {
+                greedyEnd.add( m_length-1 );
+                greedyHyphen.add( 0 );
+                break;
+            }
+            double gap = perigeeLineGap( pos, end, x, maxWidth, hyphen, gaps );
+            int fontSize = ((LVFont *)m_srcs[pos]->t.font)->getSize();
+            int space = ((LVFont *)m_srcs[pos]->t.font)->getCharWidth(' ');
+            // Natural spacing is in the leftover the line's letters leave, so gap is the whole gap.
+            if ( gaps > 0 && gap > PERIGEE_LOOSE_EM * fontSize )
+                looseLine.add( greedyEnd.length() );
+            else if ( gaps == 0 && maxWidth - x - (m_widths[end] - (pos > 0 ? m_widths[pos-1] : 0)) > space )
+                looseLine.add( greedyEnd.length() );
+            greedyEnd.add( end );
+            greedyHyphen.add( hyphen ? 1 : 0 );
+            pos = end + 1;
+        }
+        if ( looseLine.length() == 0 )
+            return false;
+
+        // Which positions the windows of the loose lines open.
+        LVArray<int> open( m_length, 0 );
+        int lines = greedyEnd.length();
+        for ( int l=0; l<looseLine.length(); l++ ) {
+            int first = looseLine[l] - PERIGEE_WINDOW_BACK;
+            int last = looseLine[l] + PERIGEE_WINDOW_FORWARD;
+            int from = first <= 0 ? 0 : greedyEnd[first-1] + 1;
+            int to = last >= lines-1 ? m_length-1 : greedyEnd[last];
+            for ( int i=from; i<=to; i++ )
+                open[i] = 1;
+        }
+
+        // Gaps before each position, the shrink they allow and their spaces.
+        LVArray<int> gapsTo( m_length+1, 0 );
+        LVArray<int> shrinkTo( m_length+1, 0 );
+        LVArray<int> spaceTo( m_length+1, 0 );
+        for ( int i=0; i<m_length; i++ ) {
+            bool gap = i < m_length-1 && (m_flags[i] & LCHAR_IS_SPACE) && !(m_flags[i] & LCHAR_LOCKED_SPACING)
+                    && !(m_flags[i+1] & LCHAR_IS_SPACE);
+            gapsTo[i+1] = gapsTo[i] + (gap ? 1 : 0);
+            shrinkTo[i+1] = shrinkTo[i] + (gap ? getMaxCondensedSpaceTruncation(i) : 0);
+            spaceTo[i+1] = spaceTo[i] + (gap ? m_widths[i] - (i > 0 ? m_widths[i-1] : 0) : 0);
+        }
+
+        // Hyphenation points of the open words.
+        LVArray<int> hyphenAt( m_length, 0 );
+        for ( int i=0; i<m_length; ) {
+            if ( !open[i] ) {
+                i++;
+                continue;
+            }
+            int wstart, wend;
+            bool has_rtl;
+            lStr_findWordBounds( m_text, m_length, i, wstart, wend, has_rtl );
+            if ( wend <= i ) {
+                i++;
+                continue;
+            }
+            i = wend;
+            src_text_fragment_t * src = m_srcs[wend-1];
+            int len = wend - wstart;
+            if ( len < MIN_WORD_LEN_TO_HYPHENATE || has_rtl || !(src->flags & LTEXT_HYPHENATE) || (src->flags & LTEXT_FLAG_NOWRAP) )
+                continue;
+            if ( len > MAX_WORD_SIZE )
+                len = MAX_WORD_SIZE;
+            int hyphen_width = 0;
+            for ( int k=wstart; k<wend && !hyphen_width; k++ )
+                if ( !(m_srcs[k]->flags & LTEXT_SRC_IS_OBJECT) )
+                    hyphen_width = ((LVFont *)m_srcs[k]->t.font)->getHyphenWidth();
+            if ( hyphen_width <= 0 )
+                continue;
+            lUInt16 widths[MAX_WORD_SIZE];
+            lUInt16 saved[MAX_WORD_SIZE];
+            int wordStart_w = wstart>0 ? m_widths[wstart-1] : 0;
+            for ( int k=0; k<len; k++ ) {
+                widths[k] = m_widths[wstart+k] - wordStart_w;
+                saved[k] = m_flags[wstart+k];
+            }
+            if ( src->lang_cfg->getHyphMethod()->hyphenate(m_text+wstart, len, widths, (lUInt8 *)(m_flags+wstart),
+                        hyphen_width, 0xFFFF, 2) ) {
+                for ( int k=0; k<len-1; k++ )
+                    if ( (m_flags[wstart+k] & LCHAR_ALLOW_HYPH_WRAP_AFTER) && !(m_flags[wstart+k+1] & LCHAR_IS_CLUSTER_TAIL) )
+                        hyphenAt[wstart+k] = hyphen_width;
+            }
+            for ( int k=0; k<len; k++ )
+                m_flags[wstart+k] = saved[k];
+        }
+
+        // Nodes: 0 is the start, node k the break after cand[k-1]; greedyNext[k] is the node the greedy
+        // line from node k ends at. Every greedy break is a node, whether its window is open or not.
+        LVArray<int> greedyAt( m_length, 0 ); // 1 + the greedy line ending here
+        for ( int l=0; l<lines; l++ )
+            greedyAt[greedyEnd[l]] = l + 1;
+        LVArray<int> cand;
+        LVArray<int> candHyphen;
+        LVArray<int> greedyNode( lines+1, 0 ); // the node of the end of greedy line l-1; 0 for the start
+        for ( int i=0; i<m_length; i++ ) {
+            bool wrap = i == m_length-1 || ( (m_flags[i] & LCHAR_ALLOW_WRAP_AFTER) && !(m_flags[i] & LCHAR_DEPRECATED_WRAP_AFTER)
+                    && !(m_flags[i+1] & LCHAR_IS_SPACE) );
+            int l = greedyAt[i];
+            if ( l > 0 ) {
+                cand.add( i );
+                int hyphen = 0;
+                if ( greedyHyphen[l-1] )
+                    hyphen = ((LVFont *)m_srcs[i]->t.font)->getHyphenWidth();
+                candHyphen.add( hyphen );
+                greedyNode[l] = cand.length();
+            }
+            else if ( open[i] && ( wrap || hyphenAt[i] > 0 ) ) {
+                cand.add( i );
+                candHyphen.add( wrap ? 0 : hyphenAt[i] );
+            }
+        }
+        int nodes = cand.length() + 1;
+        LVArray<int> greedyNext( nodes, -1 );
+        for ( int l=0; l<lines; l++ )
+            greedyNext[greedyNode[l]] = greedyNode[l+1];
+
+        const double INF = 1e30;
+        LVArray<double> best( nodes, INF );
+        LVArray<int> from( nodes, -1 );
+        LVArray<int> active;
+        LVArray<int> kept;
+        best[0] = 0;
+        active.add( 0 );
+        for ( int k=1; k<nodes && active.length() > 0; k++ ) {
+            int b = cand[k-1];
+            int hyphen = candHyphen[k-1];
+            bool last = b == m_length-1;
+            kept.clear();
+            for ( int a=0; a<active.length(); a++ ) {
+                int j = active[a];
+                int s = j == 0 ? 0 : cand[j-1] + 1;
+                int x = j == 0 ? firstX : nextX;
+                bool greedy = greedyNext[j] == k;
+                int e = b;
+                while ( e > s && (m_flags[e] & LCHAR_IS_SPACE) )
+                    e--;
+                if ( m_flags[e] & LCHAR_IS_SPACE ) {
+                    kept.add( j );
+                    continue;
+                }
+                int w0 = s > 0 ? m_widths[s-1] : 0;
+                int plain = x + m_widths[e] - w0;
+                int shrink = shrinkTo[e] - shrinkTo[s];
+                // The greedy line is always a way through: its start stays active until it is reached,
+                // and its edge is taken even if this estimate of the width says it does not fit.
+                if ( plain > maxWidth + shrink && !greedy ) {
+                    if ( greedyNext[j] > k )
+                        kept.add( j );
+                    continue;
+                }
+                kept.add( j );
+                if ( !greedy && hyphen && b <= s+1 )
+                    continue;
+                int natural = plain + hyphen;
+                if ( natural > maxWidth + shrink && !greedy )
+                    continue;
+                double cost = PERIGEE_COST_LINE;
+                if ( !greedy )
+                    cost += PERIGEE_COST_CHANGE;
+                if ( !last ) {
+                    int gaps = gapsTo[e] - gapsTo[s];
+                    int leftover = maxWidth - natural;
+                    int fontSize = ((LVFont *)m_srcs[s]->t.font)->getSize();
+                    double gap = gaps > 0 ? ( (spaceTo[e] - spaceTo[s]) + (double)leftover ) / gaps
+                                          : ( leftover > 0 ? (double)leftover : 0 );
+                    double over = gap / fontSize - PERIGEE_FREE_EM;
+                    if ( over > 0 ) {
+                        over /= 0.25;
+                        cost += 100 * over * over * over;
+                    }
+                    if ( hyphen ) {
+                        if ( !greedy )
+                            cost += PERIGEE_COST_HYPHEN;
+                        if ( j > 0 && candHyphen[j-1] )
+                            cost += PERIGEE_COST_DOUBLE_HYPHEN;
+                    }
+                }
+                if ( best[j] + cost < best[k] ) {
+                    best[k] = best[j] + cost;
+                    from[k] = j;
+                }
+            }
+            active.clear();
+            active.add( kept );
+            if ( best[k] < INF && !last )
+                active.add( k );
+        }
+        bool planned = best[nodes-1] < INF;
+        int changed = 0;
+        if ( planned ) {
+            LVArray<int> path;
+            for ( int k=nodes-1; k>0; k=from[k] ) {
+                path.add( k );
+                if ( greedyNext[from[k]] != k )
+                    changed++;
+            }
+            for ( int p=path.length()-1; p>=0; p-- ) {
+                m_perigee_breaks.add( cand[path[p]-1] );
+                m_perigee_hyphens.add( candHyphen[path[p]-1] > 0 ? 1 : 0 );
+            }
+        }
+        if ( !planned || changed == 0 ) {
+            m_perigee_breaks.clear();
+            m_perigee_hyphens.clear();
+            return false;
+        }
+        return true;
+    }
