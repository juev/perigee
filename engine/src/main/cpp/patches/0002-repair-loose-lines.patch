+/// Perigee repair of loose justified lines; the figures are measured in docs/spikes/word-gaps-preview.md.
+static const double PERIGEE_LOOSE_EM = 0.75; // a gap wider than this opens a window
+static const double PERIGEE_FREE_EM = 0.5;   // a gap up to this costs nothing
+static const int PERIGEE_WINDOW_BACK = 4;
+static const int PERIGEE_WINDOW_FORWARD = 2;
+static const double PERIGEE_COST_LINE = 5;
+static const double PERIGEE_COST_CHANGE = 1;
+static const double PERIGEE_COST_HYPHEN = 50;
+static const double PERIGEE_COST_DOUBLE_HYPHEN = 20;
