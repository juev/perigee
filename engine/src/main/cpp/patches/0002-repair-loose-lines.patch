 #define MIN_WORD_LEN_TO_HYPHENATE 4
 #define MAX_WORD_SIZE 64
 
+    /// Perigee repair: the gap, in px, of a justified line from start to the wrap at end: the width
+    /// its letters leave, shared by its gaps (a space at the wrap is not laid out). 0 without a gap.
+    double perigeeLineGap( int start, int end, int x, int maxWidth, bool hyphen, int & gaps ) {
+        int last = end;
+        while ( last > start && (m_flags[last] & LCHAR_IS_SPACE) )
+            last--;
+        int spaces = 0;
+        gaps = 0;
+        for ( int i=start; i<last; i++ ) {
+            if ( m_flags[i] & LCHAR_IS_SPACE ) {
+                spaces += m_widths[i] - (i > 0 ? m_widths[i-1] : 0);
+                if ( !(m_flags[i+1] & LCHAR_IS_SPACE) )
+                    gaps++;
+            }
+        }
+        int letters = m_widths[last] - (start > 0 ? m_widths[start-1] : 0) - spaces;
+        if ( hyphen )
+            letters += ((LVFont *)m_srcs[last]->t.font)->getHyphenWidth();
+        return gaps > 0 ? (double)(maxWidth - x - letters) / gaps : 0;
+    }
+
+    /// Perigee repair: the line processParagraph() would make from start, in short: up to
+    /// the last wrap that fits with the spaces condensed, or to a hyphenation point after it when more
+    /// than unused_space_threshold_percent would stay unused. Returns false when it is the paragraph's
+    /// last line, which is not justified; otherwise sets end and hyphen.
+    bool perigeeGreedyLine( int start, int x, int maxWidth, int & end, bool & hyphen ) {
+        int w0 = start > 0 ? m_widths[start-1] : 0;
+        int reduce = 0;
+        int wrap = -1;
+        int i;
+        for ( i=start; i<m_length; i++ ) {
+            lUInt16 flags = m_flags[i];
+            bool fits = x + m_widths[i]-w0 <= maxWidth + reduce;
+            if ( !fits && !((flags & LCHAR_IS_SPACE) && (flags & LCHAR_ALLOW_WRAP_AFTER)) )
+                break;
+            if ( (flags & LCHAR_ALLOW_WRAP_AFTER) && !(flags & LCHAR_DEPRECATED_WRAP_AFTER) )
+                wrap = i;
+            if ( i == m_length-1 )
+                return false;
+            if ( !fits )
+                break;
+            if ( (flags & LCHAR_IS_SPACE) && !(flags & LCHAR_LOCKED_SPACING) && !(m_flags[i+1] & LCHAR_IS_SPACE) )
+                reduce += getMaxCondensedSpaceTruncation(i);
+        }
+        if ( wrap < 0 )
+            wrap = i > start ? i-1 : start;
+        end = wrap;
+        hyphen = false;
+        int unused = maxWidth - (x + m_widths[wrap]-w0);
+        int wordpos = i-1;
+        // As the hyphenation loop of processParagraph() does: from the last char that fits back to
+        // the wrap, word by word, until one has a hyphenation point that fits.
+        while ( !hyphen && wordpos > wrap && unused * 100 / maxWidth > m_pbuffer->unused_space_threshold_percent ) {
+            if ( !(m_srcs[wordpos]->flags & LTEXT_HYPHENATE) || (m_srcs[wordpos]->flags & LTEXT_FLAG_NOWRAP) ) {
+                wordpos -= MIN_WORD_LEN_TO_HYPHENATE;
+                continue;
+            }
+            int wstart, wend;
+            bool has_rtl;
+            lStr_findWordBounds( m_text, m_length, wordpos, wstart, wend, has_rtl );
+            if ( wend <= wrap )
+                break;
+            int len = wend - wstart;
+            if ( len < MIN_WORD_LEN_TO_HYPHENATE || has_rtl ) {
+                wordpos = wstart - 1;
+                continue;
+            }
+            if ( wstart >= wordpos ) {
+                wordpos -= MIN_WORD_LEN_TO_HYPHENATE;
+                continue;
+            }
+            if ( len > MAX_WORD_SIZE )
+                len = MAX_WORD_SIZE;
+            lUInt16 widths[MAX_WORD_SIZE];
+            lUInt16 saved[MAX_WORD_SIZE];
+            int wordStart_w = wstart>0 ? m_widths[wstart-1] : 0;
+            for ( int k=0; k<len; k++ ) {
+                widths[k] = m_widths[wstart+k] - wordStart_w;
+                saved[k] = m_flags[wstart+k];
+            }
+            int max_width = maxWidth + reduce - (x + (wordStart_w - w0));
+            int hyphen_width = ((LVFont *)m_srcs[wstart]->t.font)->getHyphenWidth();
+            // hyphenate() sets flags in m_flags: they are put back, the line is formatted for real later
+            if ( m_srcs[wordpos]->lang_cfg->getHyphMethod()->hyphenate(m_text+wstart, len, widths,
+                        (lUInt8 *)(m_flags+wstart), hyphen_width, max_width, 2) ) {
+                for ( int k=0; k<len; k++ ) {
+                    if ( (m_flags[wstart+k] & LCHAR_ALLOW_HYPH_WRAP_AFTER) && widths[k] + hyphen_width <= max_width
+                            && wstart + k > start+1 ) {
+                        end = wstart + k;
+                        hyphen = true;
+                    }
+                }
+            }
+            for ( int k=0; k<len; k++ )
+                m_flags[wstart+k] = saved[k];
+            wordpos = wstart - 1;
+        }
+        return true;
+    }
