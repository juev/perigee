+    /// Perigee repair: images, inline boxes, floats, BiDi, CJK, initial letters,
+    /// ::first-line and preformatted line feeds are out of scope: such paragraphs stay greedy.
+    bool perigeeBreakerInScope( src_text_fragment_t * para ) {
+        if ( (para->flags & LTEXT_FLAG_NEWLINE) != LTEXT_ALIGN_WIDTH || (para->flags & LTEXT_LEGACY_RENDERING)
+                || m_pbuffer->floatcount > 0 || m_has_bidi || m_has_cjk || m_initial_letter_exclusion.active
+                || m_length < 2 || m_srcs[0]->lang_cfg->duplicateRealHyphenOnNextLine() )
+            return false;
+        for ( int i=0; i<m_length; i++ )
+            if ( (m_flags[i] & LCHAR_IS_OBJECT) || m_text[i] == '\n' || (m_srcs[i]->flags & LTEXT_IS_FIRST_LINE_CLONE) )
+                return false;
+        return getCurrentLineWidth() > 3 * m_pbuffer->strut_height;
+    }
