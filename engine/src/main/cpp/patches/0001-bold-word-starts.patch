+#include <unordered_set>
+#include <vector>
+#if USE_UTF8PROC == 1
+#include <utf8proc.h>
+#endif
+
+// Perigee: bold word starts. The opening letters of each word are set in the bold of their font, without
+// touching the document tree: a text node is handed to the line formatter as several sources, bold and
+// regular, each with the offsets of its part of the node, so xpointers, selections and highlights keep
+// pointing at the same text. Kept per document, as a page of one book may be formatted again lazily.
+static std::unordered_set<const ldomDocument *> perigeeBoldWordStartsDocs;
+
+void perigeeSetBoldWordStarts( const ldomDocument * doc, bool on )
+{
+    if ( on )
+        perigeeBoldWordStartsDocs.insert(doc);
+    else
+        perigeeBoldWordStartsDocs.erase(doc);
+}
+
+static bool perigeeBoldWordStartsIn( const ldomDocument * doc )
+{
+    return !perigeeBoldWordStartsDocs.empty() && perigeeBoldWordStartsDocs.count(doc) > 0;
+}
+
+// Letters of the scripts written in separate, unjoined letters with spaces between words: Latin, Greek,
+// Cyrillic, Armenian, Georgian, Hebrew, with their combining marks. A part of a word set in another font
+// breaks the shaping of joined scripts (Arabic, the scripts of India) and the clusters of others, and
+// scripts without word spaces (Chinese, Japanese, Thai) have no words to find: their words are left alone.
+static int perigeeWordCharKind( lChar32 c )
+{
+    // 0: not a word char; 1: a letter; 2: a mark, digit or inner apostrophe that belongs to the word
+    bool simple = c < 0x0250 || (c >= 0x0300 && c < 0x0530) || (c >= 0x0530 && c < 0x0600)
+               || (c >= 0x10A0 && c < 0x1100) || (c >= 0x1C80 && c < 0x1CC0) || (c >= 0x1E00 && c < 0x2000)
+               || (c >= 0x2DE0 && c < 0x2E00) || (c >= 0xA640 && c < 0xA6A0) || (c >= 0xFB00 && c < 0xFB50);
+#if USE_UTF8PROC == 1
+    utf8proc_category_t cat = utf8proc_category((utf8proc_int32_t)c);
+    bool letter = cat >= UTF8PROC_CATEGORY_LU && cat <= UTF8PROC_CATEGORY_LO;
+    bool mark = cat == UTF8PROC_CATEGORY_MN || cat == UTF8PROC_CATEGORY_MC;
+    bool digit = cat == UTF8PROC_CATEGORY_ND;
+#else
+    lUInt16 props = lGetCharProps(c);
+    bool letter = (props & CH_PROP_ALPHA) != 0;
+    bool mark = false;
+    bool digit = (props & CH_PROP_DIGIT) != 0;
+#endif
+    if ( letter )
+        return simple ? 1 : -1; // -1: a letter of a script left alone
+    if ( mark || digit )
+        return 2;
+    return 0;
+}
+
+// How many letters of a word of 'letters' letters are bold: one of up to three, else half, rounded up.
+static int perigeeBoldLetters( int letters )
+{
+    return letters <= 3 ? 1 : (letters + 1) / 2;
+}
+
+// Whether the text of 'parent' gets bold word starts: not text already bold, not headings, not code.
+static bool perigeeBoldWordStartsFor( ldomNode * parent, const css_style_rec_t * style )
+{
+    if ( style->font_weight >= 1 && style->font_weight <= 1000 && style->font_weight >= 600 )
+        return false;
+    if ( style->font_family == css_ff_monospace || style->white_space >= css_ws_pre )
+        return false;
+    for ( ldomNode * n = parent; n && !n->isRoot(); n = n->getParentNode() ) {
+        lUInt16 id = n->getNodeId();
+        if ( (id >= el_h1 && id <= el_h6) || id == el_title || id == el_subtitle || id == el_code || id == el_pre )
+            return false;
+    }
+    return true;
+}
 
