+// Perigee: the CSS the owner wrote, a sheet of its own per document that setNodeStyle() applies after the
+// book's styles and style= (issue #150). It comes in the user-agent stylesheet text after this marker,
+// the one of engine/src/main/cpp/jni/owner_css.h: the app's text before it never holds the marker, the
+// owner's after it may. Documents are styled on the one engine thread, so the map needs no lock. The copy
+// constructor of lxmlDocBase, which nothing in the engine calls, leaves the copy without a sheet.
+static const char perigeeOwnerMarker[] = "/*perigee:owner-css*/";
+static std::unordered_map<const lxmlDocBase *, LVStyleSheet *> perigeeOwnerSheets;
+
+LVStyleSheet * perigeeOwnerStyleSheet( const lxmlDocBase * doc )
+{
+    if ( perigeeOwnerSheets.empty() )
+        return NULL;
+    auto it = perigeeOwnerSheets.find( doc );
+    return it == perigeeOwnerSheets.end() ? NULL : it->second;
+}
+
+// For engine/tools/desktop/owner-css.cpp: how many documents have an owner's sheet.
+int perigeeOwnerStyleSheetCount()
+{
+    return (int)perigeeOwnerSheets.size();
+}
+
+static void perigeeDropOwnerStyleSheet( const lxmlDocBase * doc )
+{
+    auto it = perigeeOwnerSheets.find( doc );
+    if ( it == perigeeOwnerSheets.end() )
+        return;
+    delete it->second;
+    perigeeOwnerSheets.erase( it );
+}
