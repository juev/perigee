# Downloads a pinned source archive once (shared by all ABIs) and unpacks it
# into the per-ABI build tree. Sets <NAME>_SOURCE_DIR in the caller's scope.
set(PERIGEE_DEPS_CACHE "${PERIGEE_ROOT}/engine/.deps" CACHE PATH "source archive cache")

function(perigee_fetch NAME URL SHA256 TOP_DIR)
    get_filename_component(ARCHIVE "${URL}" NAME)
    set(ARCHIVE_PATH "${PERIGEE_DEPS_CACHE}/${NAME}-${ARCHIVE}")
    if(NOT EXISTS "${ARCHIVE_PATH}")
        message(STATUS "Downloading ${NAME}: ${URL}")
        file(DOWNLOAD "${URL}" "${ARCHIVE_PATH}.part" EXPECTED_HASH SHA256=${SHA256} TLS_VERIFY ON STATUS ST)
        list(GET ST 0 CODE)
        if(NOT CODE EQUAL 0)
            file(REMOVE "${ARCHIVE_PATH}.part")
            message(FATAL_ERROR "Download of ${URL} failed: ${ST}")
        endif()
        file(RENAME "${ARCHIVE_PATH}.part" "${ARCHIVE_PATH}")
    else()
        file(SHA256 "${ARCHIVE_PATH}" GOT)
        if(NOT GOT STREQUAL "${SHA256}")
            message(FATAL_ERROR "Hash mismatch for cached ${ARCHIVE_PATH}")
        endif()
    endif()
    set(DEST "${CMAKE_BINARY_DIR}/_src")
    if(NOT EXISTS "${DEST}/${TOP_DIR}")
        file(ARCHIVE_EXTRACT INPUT "${ARCHIVE_PATH}" DESTINATION "${DEST}")
    endif()
    set(${NAME}_SOURCE_DIR "${DEST}/${TOP_DIR}" PARENT_SCOPE)
endfunction()
